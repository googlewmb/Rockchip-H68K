# OpenWrt 配置文件 - HinLink H68K（rockchip/armv8）
# 当前保留数量：约 520+（已补官方默认驱动与基础项）
# 注意：以下仅重新分类、排序和中文注释，配置项及其取值保持不变
# 修复：补上 kmod-r8169、libc、libgcc、libustream-mbedtls、镜像分区选项


############################################################
# 01. 目标平台 / H68K 硬件
############################################################

CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_hinlink_h68k=y
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y


############################################################
# 01b. 镜像 / 根文件系统
############################################################

CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_KERNEL_PARTSIZE=16
CONFIG_TARGET_ROOTFS_PARTSIZE=400


############################################################
# BPF / eBPF 编译工具及内核支持
############################################################

# BPF 编译工具默认 VM 完整，会从源码编译 LLVM，用于支持 BTF / eBPF
# 如遇到云编译编译时间过长可选择 HOST，然后 LLVM 改成未选中
# CONFIG_BPF_TOOLCHAIN_NONE is not set
# CONFIG_BPF_TOOLCHAIN_HOST is not set
CONFIG_BPF_TOOLCHAIN_BUILD_LLVM=y

CONFIG_DEVEL=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO=y
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_BPF_EVENTS=y

CONFIG_KERNEL_XDP_SOCKETS=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y
CONFIG_PACKAGE_kmod-sched-bpf=y


############################################################
# 02. 基础系统 - OpenWrt 核心组件
############################################################

CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_fstools=y
CONFIG_PACKAGE_fwtool=y
CONFIG_PACKAGE_getrandom=y
CONFIG_PACKAGE_logd=y
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_openwrt-keyring=y
CONFIG_PACKAGE_procd=y
CONFIG_PACKAGE_procd-seccomp=y
CONFIG_PACKAGE_procd-ujail=y
CONFIG_PACKAGE_urandom-seed=y
CONFIG_PACKAGE_urngd=y
CONFIG_PACKAGE_usign=y

# C 运行库（官方默认，必须）
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_libgcc=y
CONFIG_PACKAGE_libustream-mbedtls=y

# 基础网络及数据处理
CONFIG_PACKAGE_jshn=y
CONFIG_PACKAGE_jsonfilter=y
CONFIG_PACKAGE_resolveip=y
CONFIG_PACKAGE_uclient-fetch=y

# UBus / UCI / UCode
CONFIG_PACKAGE_ubox=y
CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_ubusd=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_ucode=y
CONFIG_PACKAGE_ucode-mod-digest=y
CONFIG_PACKAGE_ucode-mod-fs=y
CONFIG_PACKAGE_ucode-mod-html=y
CONFIG_PACKAGE_ucode-mod-log=y
CONFIG_PACKAGE_ucode-mod-lua=y
CONFIG_PACKAGE_ucode-mod-math=y
CONFIG_PACKAGE_ucode-mod-nl80211=y
CONFIG_PACKAGE_ucode-mod-rtnl=y
CONFIG_PACKAGE_ucode-mod-ubus=y
CONFIG_PACKAGE_ucode-mod-uci=y
CONFIG_PACKAGE_ucode-mod-uclient=y
CONFIG_PACKAGE_ucode-mod-uloop=y

# RPC / Web 服务
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-rpcsys=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y
CONFIG_PACKAGE_rpcd-mod-ucode=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y

# 系统升级及安全
CONFIG_PACKAGE_apk-mbedtls=y
CONFIG_PACKAGE_attendedsysupgrade-common=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_cgi-io=y
CONFIG_PACKAGE_dropbear=y


############################################################
# 03. 内核模块 - 存储 / SATA / SCSI / NVMe
############################################################

CONFIG_PACKAGE_kmod-ata-ahci-dwc=y
CONFIG_PACKAGE_kmod-ata-ahci-platform=y
CONFIG_PACKAGE_kmod-ata-core=y
CONFIG_PACKAGE_kmod-cdrom=y
CONFIG_PACKAGE_kmod-nvme=y
CONFIG_PACKAGE_kmod-scsi-core=y


############################################################
